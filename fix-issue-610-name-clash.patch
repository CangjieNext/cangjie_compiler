 ERROR(sema_cj_mapping_generic_type_not_configured, "generic type '%s' used in Java interop must be configured in generic_object_configuration")
 
+ERROR(sema_cj_mapping_name_clash, "name clash detected: %s '%s' generates method '%s()' which conflicts with existing %s '%s()'")
 
