     }
 }
 
-extend Aoo <: Countable<Aoo> & Comparable<Aoo> & Equatable<Aoo> {
+extend Aoo <: Countable<Aoo> & Comparable<Aoo> {
     public func compare(rhs: Aoo): Ordering {
         match {
             case this.a < rhs.a => Ordering.LT
