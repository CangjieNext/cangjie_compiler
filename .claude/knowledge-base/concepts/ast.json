  "concept": {
    "name": "Abstract Syntax Tree (AST)",
    "definition": "抽象语法树是源代码的树状结构表示，是编译器前端的核心数据结构，将源代码的语法结构以树形式组织，每个节点代表源代码中的一个语法构造。",
    "purpose": "AST 在仓颉编译器中用于语法结构表示、语义分析基础、代码转换、序列化支持和工具支持。",
    "implementation": {
      "dataStructures": [
        "Node Hierarchy - 所有 AST 节点的基类和派生类层次结构",
        "ASTContext - AST 的内存管理器，使用 arena 分配策略",
        "SourceLocation - 源代码位置信息",
        "Type Nodes - 类型相关的 AST 节点",
        "Attribute Nodes - 属性节点"
      ],
      "algorithms": [
        "AST Construction - 递归下降解析构建 AST",
        "AST Traversal - Walker 模式遍历 AST",
        "AST Annotation - 语义分析阶段注解 AST",
        "AST Serialization - 基于 FlatBuffers 的序列化",
        "AST Deserialization - 从二进制格式恢复 AST"
      ],
      "keyFiles": [
