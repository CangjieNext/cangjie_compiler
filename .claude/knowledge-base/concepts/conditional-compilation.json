  "concept": {
    "name": "Conditional Compilation",
    "definition": "条件编译是一种编译时机制，允许根据编译条件（如目标平台、编译配置、特性标志等）选择性地编译代码。",
    "purpose": "条件编译用于平台适配、特性控制、调试支持、版本兼容和代码优化。",
    "implementation": {
      "dataStructures": [
        "ConditionalCompilation - 条件编译管理器",
        "CompilationCondition - 编译条件表达式",
        "ConditionEvaluator - 条件求值器",
        "PlatformInfo - 平台信息",
        "FeatureFlags - 特性标志集合"
      ],
      "algorithms": [
        "Condition Evaluation - 条件评估算法",
        "Code Block Selection - 代码块选择算法",
        "Preprocessor Integration - 预处理器集成",
        "Attribute Processing - 属性处理",
        "Dead Code Elimination - 死代码消除"
      ],
