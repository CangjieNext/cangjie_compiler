  "concept": {
    "name": "Macro Expansion",
    "definition": "仓颉的宏展开是编译时的元编程机制，允许在编译期执行代码生成和转换，支持编译时计算、代码生成和 AST 转换。",
    "purpose": "宏展开用于代码生成、编译时计算、DSL 支持、语法扩展和元编程。",
    "implementation": {
      "dataStructures": [
        "MacroEvaluation - 宏求值器，执行宏代码",
        "MacroExpansion - 宏展开器，管理宏展开过程",
        "MacroCall - 宏调用节点",
        "MacroDefinition - 宏定义",
        "EvaluationServer - 宏求值服务器"
      ],
      "algorithms": [
        "Macro Call Resolution - 宏调用解析和参数匹配",
        "AST Serialization - AST 节点序列化",
        "Token Serialization - Token 序列序列化",
        "Macro Evaluation - 独立进程执行宏代码",
        "Result Integration - 宏展开结果集成"
      ],
