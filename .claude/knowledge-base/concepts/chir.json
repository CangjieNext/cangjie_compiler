  "concept": {
    "name": "Cangjie High-level IR (CHIR)",
    "definition": "仓颉高层中间表示是介于 AST 和 LLVM IR 之间的中间表示层，是一种面向仓颉语言特性的中间表示，保留了高层语言的语义信息。",
    "purpose": "CHIR 用于语言特性抽象、优化基础、分析支持、降级桥梁和序列化支持。",
    "implementation": {
      "dataStructures": [
        "IR Node System - CHIR 节点体系（指令、基本块、函数）",
        "CHIRModule - CHIR 模块，包含编译单元的所有 CHIR 代码",
        "CHIRBuilder - CHIR 构建器，从 AST 生成 CHIR",
        "CHIRType - CHIR 类型系统",
        "CHIRValue - CHIR 值系统"
      ],
      "algorithms": [
        "AST2CHIR Conversion - AST 到 CHIR 的转换算法",
        "SSA Construction - 构建静态单赋值形式",
        "Optimization Passes - CHIR 层面的优化遍",
        "Analysis Passes - 程序分析遍",
        "CHIR Lowering - CHIR 到 LLVM IR 的降级"
      ],
