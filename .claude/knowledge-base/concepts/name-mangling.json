  "concept": {
    "name": "Name Mangling",
    "definition": "名称修饰是将程序中的符号名称编码为唯一字符串的过程，用于解决符号重载、泛型实例化、命名空间等导致的符号名称冲突问题。",
    "purpose": "名称修饰用于符号唯一性、重载支持、泛型实例化、模块隔离和 ABI 兼容性。",
    "implementation": {
      "dataStructures": [
        "BaseMangler - 名称修饰基类，提供通用算法",
        "ASTMangler - 基于 AST 的名称修饰器",
        "CHIRMangler - 基于 CHIR 的名称修饰器",
        "ManglingContext - 修饰上下文",
        "CompressionTable - 压缩表"
      ],
      "algorithms": [
        "Compression Algorithm - 压缩算法，减少修饰名称长度",
        "Type Encoding - 类型编码算法",
        "Signature Mangling - 函数签名修饰",
        "Generic Mangling - 泛型修饰",
        "Module Path Encoding - 模块路径编码"
      ],
      "keyFiles": [
        "/usr1/ace/cangjie_compiler/include/cangjie/Mangle/BaseMangler.h",
