  "concept": {
    "name": "Serialization Formats",
    "definition": "序列化格式是仓颉编译器用于持久化和传输数据结构的二进制格式规范，主要基于 FlatBuffers 框架，用于 AST、CHIR、模块等数据结构的序列化。",
    "purpose": "序列化格式用于编译缓存、模块通信、宏展开、持久化存储和跨进程通信。",
    "implementation": {
      "dataStructures": [
        "FlatBuffers Schema - FlatBuffers 模式定义",
        "Serializer - 序列化器，转换为二进制格式",
        "Deserializer - 反序列化器，恢复数据结构",
        "Buffer - 序列化缓冲区",
        "Verifier - 验证器"
      ],
      "algorithms": [
        "FlatBuffers Serialization - 零拷贝序列化",
        "AST Serialization - 递归序列化 AST 节点树",
        "CHIR Serialization - 序列化 CHIR 模块和指令",
        "Type Serialization - 序列化类型信息",
        "Incremental Serialization - 增量序列化"
      ],
      "keyFiles": [
