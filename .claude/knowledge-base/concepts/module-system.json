  "concept": {
    "name": "Module System",
    "definition": "仓颉的模块系统是编译器中负责管理代码组织、依赖关系和符号可见性的核心组件，支持包和模块两级组织结构。",
    "purpose": "模块系统用于代码组织、依赖管理、符号解析、可见性控制和编译缓存。",
    "implementation": {
      "dataStructures": [
        "ImportManager - 导入管理器，处理 import 语句",
        "PackageManager - 包管理器，管理包的加载和依赖",
        "CjoManager - CJO 文件管理器，处理编译缓存",
        "ModuleDecl - 模块声明 AST 节点",
        "DependencyGraph - 模块依赖图"
      ],
      "algorithms": [
        "Import Resolution - 导入解析算法",
        "Dependency Analysis - 依赖分析和循环检测",
        "Module Loading - 模块加载算法",
        "Symbol Export/Import - 符号导出导入管理",
        "Incremental Compilation - 增量编译算法"
      ],
      "keyFiles": [
        "/usr1/ace/cangjie_compiler/include/cangjie/Modules/ImportManager.h",
        "/usr1/ace/cangjie_compiler/include/cangjie/Modules/PackageManager.h",
        "/usr1/ace/cangjie_compiler/include/cangjie/Modules/CjoManager.h",
