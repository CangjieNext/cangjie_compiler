if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()

if(NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "OUTPUT_FILE is required")
endif()

execute_process(
    COMMAND git -C "${SOURCE_DIR}" log -1 "--format=%h %s"
    OUTPUT_VARIABLE GIT_COMMIT_INFO
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
)

if(NOT GIT_COMMIT_INFO)
    set(GIT_COMMIT_INFO "unknown")
endif()

string(REPLACE "\\" "\\\\" GIT_COMMIT_INFO "${GIT_COMMIT_INFO}")
string(REPLACE "\"" "\\\"" GIT_COMMIT_INFO "${GIT_COMMIT_INFO}")
string(REPLACE ";" " " GIT_COMMIT_INFO "${GIT_COMMIT_INFO}")
string(REPLACE "\r" " " GIT_COMMIT_INFO "${GIT_COMMIT_INFO}")
string(REPLACE "\n" " " GIT_COMMIT_INFO "${GIT_COMMIT_INFO}")

set(OUTPUT_CONTENT
"// This file is generated by CMake. Do not edit.

namespace Cangjie {
extern const char CANGJIE_GIT_COMMIT_INFO[] = \"${GIT_COMMIT_INFO}\";
} // namespace Cangjie

")

get_filename_component(OUTPUT_DIR "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(TMP_FILE "${OUTPUT_FILE}.tmp")
file(WRITE "${TMP_FILE}" "${OUTPUT_CONTENT}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${TMP_FILE}" "${OUTPUT_FILE}")
file(REMOVE "${TMP_FILE}")
