---
 src/Sema/Desugar/AfterTypeCheck.cpp           |  3 +--
 .../AfterTypeCheck/TypeCheckJavaInterop.cpp   | 20 +++++++++++++++++--
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/src/Sema/Desugar/AfterTypeCheck.cpp b/src/Sema/Desugar/AfterTypeCheck.cpp
index 0497235b..e82d3fba 100644
--- a/src/Sema/Desugar/AfterTypeCheck.cpp
+++ b/src/Sema/Desugar/AfterTypeCheck.cpp
@@ -348,8 +348,7 @@ void TypeChecker::TypeCheckerImpl::ParsePackageConfigFile(
                             }
                             for (auto& member : decl->GetMemberDecls()) {
                                 if (member->symbol &&
-                                    (!decl->symbol->isNeedExposedToInterop &&
-                                        (element == (decl->symbol->name + "." + member->symbol->name)))) {
+                                    (element == (decl->symbol->name + "." + member->symbol->name))) {
                                     member->symbol->isNeedExposedToInterop = false;
                                 }
                             }
diff --git a/src/Sema/NativeFFI/Java/AfterTypeCheck/TypeCheckJavaInterop.cpp b/src/Sema/NativeFFI/Java/AfterTypeCheck/TypeCheckJavaInterop.cpp
index 9b0e3656..a377f97d 100644
--- a/src/Sema/NativeFFI/Java/AfterTypeCheck/TypeCheckJavaInterop.cpp
+++ b/src/Sema/NativeFFI/Java/AfterTypeCheck/TypeCheckJavaInterop.cpp
@@ -77,11 +77,20 @@ struct JavaInteropTypeChecker {
         }
     }
 
+    bool ContainsGenericTypeParam(const std::string& typeStr) const
+    {
+        return typeStr.find("Generics-") != std::string::npos;
+    }
+
     bool IsLambdaTypeConfigured(const Ptr<Ty>& ty) const
     {
         if (!curPackage || ty->kind != TypeKind::TYPE_FUNC) {
             return true;
         }
+        std::string typeStr = ty->String();
+        if (ContainsGenericTypeParam(typeStr)) {
+            return true;
+        }
         const auto& lambdaPatterns = curPackage->GetLambdaPatterns();
         if (lambdaPatterns.empty()) {
             return false;
@@ -115,13 +124,20 @@ struct JavaInteropTypeChecker {
         if (!curPackage || !ty->IsTuple()) {
             return true;
         }
+        std::string tupleStr = ty->String();
+        if (ContainsGenericTypeParam(tupleStr)) {
+            return true;
+        }
         const auto& interopTuples = curPackage->interopTuples;
         if (interopTuples.empty()) {
             return false;
         }
-        std::string tupleStr = ty->String();
+        std::string configStr = tupleStr;
+        if (configStr.substr(0, 6) == "Tuple<") {
+            configStr = "(" + configStr.substr(6, configStr.size() - 7) + ")";
+        }
         for (const auto& config : interopTuples) {
-            if (config == tupleStr) {
+            if (config == tupleStr || config == configStr) {
                 return true;
             }
         }
